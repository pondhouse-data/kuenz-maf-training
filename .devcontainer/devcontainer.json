{
  "name": "Künz MAF Training",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      "aspNetCoreRuntimeVersions": "10.0"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.dotnet/tools"
  },
  "postCreateCommand": "dotnet tool install --global Microsoft.PowerApps.CLI.Tool --version 2.13.1",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.debugpy",
        "ms-windows-ai-studio.windows-ai-studio"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 16,
        "python.terminal.activateEnvironment": false
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
